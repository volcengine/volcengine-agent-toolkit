{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volcengine.com/schemas/landing-zone-contract.schema.json",
  "title": "Volcengine Landing Zone runtime contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/confirmedArchitecture"
    },
    {
      "$ref": "#/$defs/landingZoneContext"
    }
  ],
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finance",
        "identity",
        "log",
        "network"
      ],
      "properties": {
        "finance": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "log": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        }
      }
    },
    "ou": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parent_key",
        "level",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_name",
        "show_name",
        "ou_key",
        "description",
        "financial_account_alias",
        "finance_enabled",
        "identity_enabled",
        "allow_console",
        "allow_exit",
        "verification_relation_id",
        "tags"
      ],
      "properties": {
        "account_name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 20
        },
        "show_name": {
          "type": "string",
          "minLength": 1
        },
        "ou_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "financial_account_alias": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "finance_enabled": {
          "type": "boolean"
        },
        "identity_enabled": {
          "type": "boolean"
        },
        "allow_console": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            1,
            2,
            null
          ]
        },
        "allow_exit": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            1,
            2,
            null
          ]
        },
        "verification_relation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "organizationArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ous",
        "accounts",
        "role_account_keys"
      ],
      "properties": {
        "ous": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "$ref": "#/$defs/stableKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ou"
          }
        },
        "accounts": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "$ref": "#/$defs/stableKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/account"
          }
        },
        "role_account_keys": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/stableKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/stableKey"
          }
        }
      }
    },
    "confirmedArchitecture": {
      "title": "Confirmed Landing Zone architecture",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "settings",
        "capabilities",
        "organization_architecture"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "base"
          ],
          "properties": {
            "mode": {
              "enum": [
                "default",
                "custom"
              ]
            },
            "base": {
              "const": "recommended-v1"
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefix",
            "region"
          ],
          "properties": {
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{2,12}$"
            },
            "region": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "organization_architecture": {
          "$ref": "#/$defs/organizationArchitecture"
        }
      }
    },
    "ouCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "parent_key",
        "level",
        "description",
        "reused"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "parent_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "reused": {
          "type": "boolean"
        }
      }
    },
    "accountCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "account_name",
        "show_name",
        "ou_key",
        "ou_id",
        "financial_account_alias",
        "finance_enabled",
        "identity_enabled",
        "roles",
        "reused"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "account_name": {
          "type": "string",
          "minLength": 1
        },
        "show_name": {
          "type": "string",
          "minLength": 1
        },
        "ou_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "ou_id": {
          "type": "string",
          "minLength": 1
        },
        "financial_account_alias": {
          "type": "string",
          "minLength": 1
        },
        "finance_enabled": {
          "type": "boolean"
        },
        "identity_enabled": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableKey"
          }
        },
        "reused": {
          "type": "boolean"
        }
      }
    },
    "financeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "account_alias"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "account_alias": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "landingZoneContext": {
      "title": "Landing Zone phase hand-off context",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "configuration",
        "producer",
        "execution_scope",
        "organization",
        "phase_inputs"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "architecture_profile",
            "architecture_mode",
            "architecture_sha256",
            "prefix",
            "region",
            "capabilities"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "architecture_profile": {
              "const": "recommended-v1"
            },
            "architecture_mode": {
              "enum": [
                "default",
                "custom"
              ]
            },
            "architecture_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{2,12}$"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "capabilities": {
              "$ref": "#/$defs/capabilities"
            }
          }
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "state_lineage",
            "state_serial"
          ],
          "properties": {
            "phase": {
              "const": "01-organization"
            },
            "state_lineage": {
              "type": "string",
              "minLength": 1
            },
            "state_serial": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "execution_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "management_account_id",
            "organization_id",
            "root_ou_id"
          ],
          "properties": {
            "management_account_id": {
              "type": "string",
              "minLength": 1
            },
            "organization_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "root_ou_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ou_catalog",
            "account_catalog",
            "account_ids_by_key",
            "account_ids_by_role"
          ],
          "properties": {
            "ou_catalog": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/stableKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/ouCatalogEntry"
              }
            },
            "account_catalog": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/stableKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/accountCatalogEntry"
              }
            },
            "account_ids_by_key": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/stableKey"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "account_ids_by_role": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/stableKey"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "phase_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finance",
            "identity",
            "log",
            "network"
          ],
          "properties": {
            "finance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "targets"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "targets": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/stableKey"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/financeTarget"
                  }
                }
              }
            },
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "target_account_ids"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "target_account_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "log": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "account_id"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "account_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "account_id"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "account_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
